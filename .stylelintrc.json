{
  "rules": {},
  "overrides": [
    {
      "files": ["web/themes/custom/mercury/src/main.css", "web/themes/custom/mercury/components/**/*.tailwind.css"],
      "rules": {
        "declaration-no-important": true,
        "selector-max-id": 0,
        "selector-max-specificity": "0,3,1",
        "selector-max-compound-selectors": 3,
        "selector-max-type": 1,
        "selector-max-universal": 1,
        "no-duplicate-selectors": true,
        "declaration-block-no-duplicate-properties": true,
        "at-rule-no-unknown": [true, { "ignoreAtRules": ["theme", "source", "apply", "layer", "variant", "custom-variant", "utility", "config", "reference", "plugin"] }]
      }
    },
    {
      "files": ["web/theme.css", "web/fonts.css"],
      "rules": {
        "property-allowed-list": ["/^--/"],
        "at-rule-allowed-list": ["media"]
      }
    },
    {
      "files": ["web/fonts.css"],
      "rules": {
        "property-allowed-list": ["/^--/", "font-family", "src", "font-weight", "font-style", "font-display", "unicode-range", "font-stretch"],
        "at-rule-allowed-list": ["font-face"]
      }
    }
  ]
}
