# Dependencies managed by Composer.
/recipes
/vendor
/web/core
/web/libraries
/web/modules/contrib
/web/profiles/contrib
/web/themes/contrib

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Site-specific settings and files.
/web/sites/*/settings*.php
/web/sites/*/services*.yml
/web/sites/*/files
/web/sites/*/private

# Test site directories generated by automated testing.
/web/sites/simpletest

# PHP scripts scaffolded into the web root by Drupal core.
/web/*.php

# Project-level authentication and authorization credentials for Composer.
# Per https://getcomposer.org/doc/articles/authentication-for-private-packages.md#authentication-in-auth-json-per-project,
# this should never be under version control.
/auth.json

# Coding pipeline run state and worktrees
docs/handoffs/state.json
docs/handoffs/*/.stage/
# Dual-review gate scratch (assembled prompts + token usage), generated per run.
docs/handoffs/*/*.prompt.txt
docs/handoffs/*/*.usage.json
.claude/worktrees/
.phpunit.cache/
# Generated from the private Aftersight Claude release; regenerate per machine
# (see "Coding pipeline" in README.md). Not committed: this repo is public.
.claude/agents/
