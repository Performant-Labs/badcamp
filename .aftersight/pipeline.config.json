{
  "configShapeVersion": 1,
  "project": "badcamp",
  "description": "BADCamp site: Drupal CMS 2 (Starter template) on DDEV.",
  "test": {
    "unit": { "command": ["scripts/run-tests.sh"], "timeoutMs": 900000 },
    "e2e": null,
    "pluginSuite": null,
    "pluginTypecheck": null
  },
  "paths": {
    "test": ["web/modules/custom/*/tests/**", "web/themes/custom/*/tests/**"],
    "production": ["web/modules/custom/**", "web/themes/custom/**", "composer.json", "composer.lock"]
  },
  "toolchain": [
    {
      "name": "ddev",
      "command": ["ddev", "--version"],
      "versionRegex": "ddev version v(\\d+\\.\\d+\\.\\d+)",
      "hint": "install DDEV (https://ddev.com/get-started/) and start Docker (OrbStack)"
    }
  ],
  "gitHooks": { "required": false, "setupHint": "" },
  "secretScan": { "required": false, "command": ["gitleaks", "version"], "hint": "install gitleaks" },
  "handoffs": { "dir": "docs/handoffs", "trackedProbe": "decisions.md" },
  "worktree": { "dir": ".claude/worktrees", "basePort": 9000, "linkDirs": [".aftersight/releases"] },
  "gateProvider": null
}
